  [[ -f "$VS" ]] || continue
  python3 - "$VS" "$DRY" <<'PY'
import json, os, re, shutil, sys
f, dry = sys.argv[1], sys.argv[2] == "1"
name = os.path.basename(os.path.dirname(os.path.dirname(f)))
def strip_jsonc(s):
    # drop // and /* */ comments outside strings, then trailing commas
    out, i, quoted = [], 0, False
    while i < len(s):
        c = s[i]
        if quoted:
            out.append(c)
            if c == "\\": out.append(s[i + 1:i + 2]); i += 2; continue
            if c == '"': quoted = False
        elif c == '"': quoted = True; out.append(c)
        elif s.startswith("//", i):
            j = s.find("\n", i); i = len(s) if j < 0 else j; continue
        elif s.startswith("/*", i):
            j = s.find("*/", i + 2); i = len(s) if j < 0 else j + 2; continue
        else: out.append(c)
        i += 1
    return re.sub(r",(\s*[}\]])", r"\1", "".join(out))
text = open(f).read()
try: d, plain = json.loads(text), True
except ValueError:
    try: d, plain = json.loads(strip_jsonc(text)), False
    except ValueError: print(f"   {name}: settings.json does not parse — skipping"); sys.exit()
watch = dict(d.get("files.watcherExclude") or {})
watch.update({f"**/{x}/**": True for x in
    ["node_modules", "vendor", ".git", "target", ".venv", "__pycache__", "dist", "build",
     ".next", ".gradle", "Pods", "storage/logs", "storage/framework", "coverage"]})
want = {
 "files.watcherExclude": watch,
 "search.followSymlinks": False, "npm.autoDetect": "off", "task.autoDetect": "off",
 "telemetry.telemetryLevel": "off", "workbench.enableExperiments": False,
 "extensions.autoCheckUpdates": False, "git.autofetch": False,
}
bad = {k: v for k, v in want.items() if d.get(k) != v}
if not bad: print(f"   {name}: watcher and telemetry are set ✓"); sys.exit()
if not plain:
    # rewriting would lose the user's comments
    print(f"   {name}: settings.json has comments — not rewriting it; set by hand:")
    for k in bad: print(f"      {k}")
    sys.exit()
for k in bad: print(f"   {'[dry] ' if dry else '✓ '}{name}: {k}")
if not dry:
    shutil.copy2(f, f + ".mac-tune.bak")
    d.update(bad)
    json.dump(d, open(f + ".tmp", "w"), indent=2, ensure_ascii=False); os.replace(f + ".tmp", f)
    print(f"   restart {name} to apply (backup: settings.json.mac-tune.bak)")
PY
